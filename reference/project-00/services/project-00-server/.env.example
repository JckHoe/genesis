# Copy to .env and fill in. Loaded automatically (godotenv); overrides application.yml.
# Keys map to config: nested `.` becomes `_` (e.g. db.url -> DB_URL).

# Log level for prod: debug, info, warning, error
LOG_LEVEL=info

# Postgres connection string for the deployment database
DB_URL=postgres://user:changeme@host:5432/dbname?sslmode=require
